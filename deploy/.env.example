# Variables para la pestaña Environment de Dokploy (se escriben en deploy/.env)

# Postgres (servicio db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=patitas

# Conexion de Django a la base: mismos valores que POSTGRES_*
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=patitas
DATABASE_USER=postgres
DATABASE_PASSWORD=

# Django
SECRET_KEY=
DEBUG=0
# "api" es obligatorio: es el host con el que el SSR de Next y el healthcheck llaman al backend
DJANGO_ALLOWED_HOSTS=esperanza-canina.com,www.esperanza-canina.com,admin.esperanza-canina.com,api
DJANGO_CSRF_TRUSTED_ORIGINS=https://esperanza-canina.com,https://www.esperanza-canina.com,https://admin.esperanza-canina.com
DJANGO_CORS_ALLOWED_ORIGINS=https://esperanza-canina.com,https://www.esperanza-canina.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=
CLOUDINARY_TAG=

# Correo (lo envia el worker de django_q)
GMAIL_ACCOUNT=
GOOGLE_APP_PASSWORD=
DESTINATARY_EMAIL=
